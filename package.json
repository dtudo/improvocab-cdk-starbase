{
  "name": "@dtudo/improvocab-cdk-starbase",
  "version": "0.0.0",
  "description": "CDK library of shared infrastructure constructs",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtudo/improvocab-cdk-starbase.git"
  },
  "scripts": {
    "commit": "commit",
    "husky": "./scripts/install-husky.cjs",
    "prepare": "npm run husky",
    "clean": "rm -rf build .cache coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prebuild": "npm run typecheck",
    "build": "tsc --project tsconfig.build.json",
    "test": "jest",
    "lint:md": "markdownlint-cli2 '**/*.md' --fix",
    "lint:es": "eslint . --fix",
    "lint": "npm run lint:md && npm run lint:es",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@commitlint/prompt-cli": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.0",
    "aws-cdk-lib": "2.209.0",
    "constructs": "10.4.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "lint-staged": "^16.1.4",
    "markdownlint": "^0.38.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.209.0",
    "constructs": "^10.4.2"
  }
}
